<!-- QR Code Modal -->
<dialog id="qr-modal" class="rounded-2xl p-4 border-0 shadow-2xl fixed inset-0 m-auto">
	<div class="flex flex-col items-center gap-3">
		<img id="qr-img" src="" alt="QR Code" class="w-64 h-64 rounded-xl" />
		<p class="text-sm text-gray-500">Scan to visit wonglok.com</p>
		<button id="qr-close" class="cursor-pointer px-4 py-2 bg-[#333] text-white rounded-xl text-xs">Close</button>
	</div>
</dialog>

<style>
	#qr-modal::backdrop {
		background: rgba(0, 0, 0, 0.5);
	}
</style>

<script>
	const qrBtn = document.getElementById('qr-btn') as any;
	const qrModal = document.getElementById('qr-modal') as any;
	const qrClose = document.getElementById('qr-close') as any;
	const qrImg = document.getElementById('qr-img') as any;

	qrImg.src = 'https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=https://wonglok.com';

	qrBtn.addEventListener('click', () => {
		qrModal.showModal();
	});

	qrClose.addEventListener('click', () => {
		qrModal.close();
	});

	qrModal.addEventListener('click', (e) => {
		if (e.target === qrModal) qrModal.close();
	});
</script>
